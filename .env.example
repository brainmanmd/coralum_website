# Oura Ring OAuth Credentials
# Get from: https://cloud.ouraring.com/docs/authentication
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:3000/api/oura/callback

# WHOOP OAuth Credentials
# Get from: https://developer.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# Fitbit OAuth Credentials
# Get from: https://dev.fitbit.com/build/reference/web-api/oauth2-guide/
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:3000/api/fitbit/callback

# Google Health / Fit OAuth Credentials
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Apple Health OAuth Credentials
# Get from: https://developer.apple.com/account/
# Note: Apple requires a JWT signed with ES256 private key
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=http://localhost:3000/api/apple/callback

# Apple-specific: JWT signing credentials
# Generate from Apple Developer portal under "Certificates, Identifiers & Profiles"
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Samsung Health OAuth Credentials
# Get from: https://developer.samsung.com/health
SAMSUNG_CLIENT_ID=
SAMSUNG_CLIENT_SECRET=
SAMSUNG_REDIRECT_URI=http://localhost:3000/api/samsung/callback

# Database and persistent storage (to be implemented)
# DATABASE_URL=

# Optional: Analytics and monitoring
# NEXT_PUBLIC_ANALYTICS_ID=

# PostgreSQL (Vercel Postgres)
# Get from: vercel env pull (after linking to Vercel)
POSTGRES_URL="postgresql://..."
POSTGRES_URL_NON_POOLING="postgresql://..."

# Calendly
# Create account at calendly.com, generate booking URL
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/yourteam/onboarding"

# Session
SESSION_EXPIRY_DAYS=30
