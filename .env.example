# PostgreSQL (GCP Cloud SQL or another managed Postgres provider)
# Provide a connection string for local development and for your container runtime.
# Example for GCP Cloud SQL via unix socket:
# POSTGRES_URL="postgresql://user:password@localhost:5432/appdb?host=/cloudsql/PROJECT_ID:REGION:INSTANCE"
# Example for a direct TCP connection:
# POSTGRES_URL="postgresql://user:password@10.0.0.5:5432/appdb"
POSTGRES_URL="postgresql://user:password@localhost:5432/appdb"
POSTGRES_URL_NON_POOLING="postgresql://user:password@localhost:5432/appdb"

# Clinician auth (dashboard)
# Secret used to sign clinician session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Used only by `npm run db:seed` to create/update the demo clinician account.
SEED_CLINICIAN_EMAIL="elena.voss@coralum.ai"
SEED_CLINICIAN_PASSWORD=""
# SEED_CLINICIAN_NAME="Dr. Elena Voss"
# SEED_CLINICIAN_SPECIALTY="Neurology"

# Optional: Analytics and monitoring
# NEXT_PUBLIC_ANALYTICS_ID=
